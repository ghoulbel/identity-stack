# Copy to .env and fill in real values, or run ./bootstrap.sh to generate them.
# NEVER commit .env.

# --- published by ../bootstrap.sh -------------------------------------------
# This host's Tailscale IPv4 and MagicDNS name. Do not hand-edit: bootstrap.sh
# rewrites these so they follow the host when the server is replaced. If this
# is unset the stack refuses to start rather than binding 0.0.0.0.
TAILSCALE_IP=
TAILSCALE_DNS=

# --- database ----------------------------------------------------------------
PG_DB=authentik
PG_USER=authentik
# PostgreSQL refuses passwords longer than 99 characters.
PG_PASS=

# --- authentik ---------------------------------------------------------------
# Opens the internal signing of tokens and sessions. Rotating it logs everyone
# out and invalidates existing cookies, so treat it as permanent.
AUTHENTIK_SECRET_KEY=

# Initial admin (akadmin). Consumed ONLY on a first-ever initialisation.
# After that it is inert — change the password in the UI, not here.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# API token for `ak` CLI (outpost + config management). Also first-boot only.
AUTHENTIK_BOOTSTRAP_TOKEN=

# OAuth client secret for Grafana, injected into the provider by
# blueprints/apps/grafana.yaml through the !Env tag so no credential is ever
# written into a committed file. Regenerating it means re-running the
# blueprint; Grafana's copy in its own .env must be updated to match.
GRAFANA_OAUTH_SECRET=

# --- family accounts ---------------------------------------------------------
# These two people already had OpenWebUI accounts before SSO existed. Their
# OpenWebUI passwords are bcrypt-only and cannot be carried into Authentik, so
# blueprints/users.yaml creates the SSO side of those same identities and
# injects the password below through !Env.
#
# The passwords are generated randomly and are deliberately NOT their old
# OpenWebUI passwords. Hand each one over once, then have them change it in the
# UI and enrol TOTP. bootstrap.sh only generates these when they are missing —
# it never rotates them, because rotating would silently reset a password
# somebody is already using.
MARINA_TEMP_PASSWORD=
MONCEF_TEMP_PASSWORD=

# NOTE: there is intentionally no AUTHENTIK_URL here. Authentik 2026.8 has no
# such setting — setting one does nothing, and every login redirect silently
# falls back to http://localhost. The public URL comes from the Brand matched
# against the Host header, configured in blueprints/forward-auth.yaml
# (domain: sso.ghoulhub.uk). Keep these three in sync when changing the host:
#   * blueprints/forward-auth.yaml  -> brand.domain  + provider.external_host
#   * proxy-stack                   -> Host(`sso.ghoulhub.uk`) router
#   * /etc/cloudflared/config.yml   -> hostname sso.ghoulhub.uk

# CHANGED 2026-10-07: this was empty and is now .ghoulhub.uk.
#
# With it empty, Authentik's own `authentik_session` cookie was host-only to
# sso.ghoulhub.uk while the forward-auth outpost token was scoped to
# .ghoulhub.uk by the provider. akadmin (the only account with TOTP) reported
# that he entered credentials + code, the app loaded, and then the browser was
# bounced back to the SSO identification form from the start. Sharing one
# cookie domain across the whole zone is the documented requirement for
# multi-subdomain SSO, so both scopes now match.
#
# The tradeoff is real and worth stating: the session cookie is now readable by
# every *.ghoulhub.uk origin, not just sso. That is inherent to wanting one
# login across subdomains. The forward-auth token is still what authorises an
# app -- a stolen session cookie on another origin still cannot reach an app
# without the outpost token that forward-auth requires.
AUTHENTIK_COOKIE_DOMAIN=.ghoulhub.uk

# Host port for the recovery listener. Deliberately NOT 80/443 (Traefik owns
# those) and deliberately not exposed beyond loopback + Tailscale.
AUTHENTIK_RECOVERY_PORT=9000

TZ=Europe/Zurich
# Public URL root (scheme + host) Authentik builds its own links from.
# Must match the sso.ghoulhub.uk router in proxy-stack and the brand domain in
# blueprints/forward-auth.yaml. Left empty it falls back to http://localhost.
AUTHENTIK_WEB_BASE_URL=https://sso.ghoulhub.uk

# OAuth client secret for the Embrace (intimacy-connection) OIDC client.
# Generated by ./bootstrap.sh and mirrored into ../ai-project/intimacy-connection/.env.
# Never rotate once set: a rotation propagates here while the running app keeps
# the old value, producing an invalid_client error that looks like an Authentik fault.
EMBRACE_OAUTH_SECRET=

# --- Authentik database backups -----------------------------------------------
# Local time for the nightly pg_dump. Must be EARLIER than Kopia's Tier 1
# snapshot (03:17) so the snapshot is guaranteed to contain that night's
# dump. The script logs the resolved next-run time on every start, so a
# wrong value here is visible in `docker logs authentik-db-backup`.
DB_BACKUP_AT=02:47
DB_BACKUP_KEEP_DAYS=14
